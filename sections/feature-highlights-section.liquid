  {{ 'custom.css' | asset_url | stylesheet_tag: preload: true }}

 {%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  :root {
    --bg: {{ section.settings.bg_color }};
    --fg: {{ section.settings.fg_color }};
    --fg-soft: {{ section.settings.fg_soft_color }};
    --card-bg: {{ section.settings.card_bg }};
    --border: {{ section.settings.border_color }};
    --accent: {{ section.settings.accent_color }};
    --accent-tint: {{ section.settings.accent_tint }};
    --shadow: rgba(28,27,24,0.16);
    --radius-l: 18px;
    --radius-m: 12px;
  }
{%- endstyle -%}

<section class="featured-collection-section section-{{ section.id }}-padding" id="shopify-section-{{ section.id }}">
  <div class="fc-wrap">
    
    <div class="fc-products-head">
      {%- if section.settings.eyebrow != blank -%}
        <div class="fc-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2>{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p>{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="fc-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product != blank -%}
            <div class="fc-card" data-product-id="{{ product.id }}" {{ block.shopify_attributes }}>
              <div class="fc-card-media">
                {%- if block.settings.custom_tag != blank -%}
                  <span class="fc-card-tag">{{ block.settings.custom_tag }}</span>
                {%- elsif product.compare_at_price > product.price -%}
                  <span class="fc-card-tag">Sale</span>
                {%- elsif product.tags contains 'New' -%}
                  <span class="fc-card-tag">New</span>
                {%- endif -%}
 

     {%- if product.featured_image != blank -%}
        {{
          product.featured_image
          | image_url: width: 600
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '320, 480, 600',
            sizes: '(min-width: 750px) 600px, 100vw',
            alt: product.featured_image.alt
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'fc-placeholder' }}
      {%- endif -%}

                {%- if product.variants.size > 1 and product.available -%}
                  <button type="button" class="fc-card-quickshop" data-variant-id="{{ product.selected_or_first_available_variant.id }}">Quick add</button>
                {%- else -%}
                  <a href="{{ product.url }}" class="fc-card-quickshop">Quick shop</a>
                {%- endif -%}
              </div>

              <div class="fc-card-body">
                <div class="fc-card-cat">{{ block.settings.custom_category  | default: product.type }}</div>
                <a href="{{ product.url }}" class="fc-card-title" style="text-decoration:none; color:inherit;">{{ block.settings.custom_title | default: product.title  }}</a>
                <div class="fc-card-stars">★★★★★</div>
                <div class="fc-card-price-row">
                  <span class="fc-card-price">{{ product.price | money }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <span class="fc-card-price-was">{{ product.compare_at_price | money }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      
      {%- endif -%}
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const quickAdds = document.querySelectorAll('#shopify-section-{{ section.id }} .fc-card-quickshop[data-variant-id]');
    
    quickAdds.forEach(button => {
      button.addEventListener('click', async (e) => {
        e.preventDefault();
        const variantId = button.getAttribute('data-variant-id');
        button.textContent = 'Adding...';

        try {
          let response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: variantId, quantity: 1 })
          });
          let cart = await response.json();
          button.textContent = 'Added! ✓';
          setTimeout(() => { button.textContent = 'Quick add'; }, 2000);
          
          document.dispatchEvent(new CustomEvent('cart:refresh', { detail: cart }));
        } catch (err) {
          console.error('Error adding to cart:', err);
          button.textContent = 'Error';
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Feature highlights",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Full Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Everything in one place"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A scalable grid built to hold custom product blocks with individual overrides."
    },
    {
      "type": "header",
      "content": "Theme Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FAFAF7"
    },
    {
      "type": "color",
      "id": "fg_color",
      "label": "Text Primary",
      "default": "#1C1B18"
    },
    {
      "type": "color",
      "id": "fg_soft_color",
      "label": "Text Soft",
      "default": "#5C5A50"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#E4E1D8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#2F4B3C"
    },
    {
      "type": "color",
      "id": "accent_tint",
      "label": "Accent Tint",
      "default": "#E7EEE9"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title Override",
          "info": "Leave blank to use the actual product title."
        },
        {
          "type": "text",
          "id": "custom_category",
          "label": "Custom Product Type",
          "info": "Leave blank to use the product type."
        },
        {
          "type": "text",
          "id": "custom_tag",
          "label": "Custom Badge Tag (e.g. New, Sale)",
          "info": "Leave blank to use product tags/sale pricing status."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature highlights",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}